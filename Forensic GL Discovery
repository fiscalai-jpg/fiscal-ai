          <input type="number" class="ded-input" id="inp_${l.id}" placeholder="0" min="0" oninput="sv('${l.id}',this.value);recalc()"></div>
          <div><div class="ded-deductible zero" id="ded_${l.id}">$0</div><div class="ded-pct">${pl}</div></div></div>`;
      }
    });
    card.innerHTML=`
      <div class="cat-header" onclick="toggle('${cat.id}')">
        <div class="cat-icon">${cat.icon}</div>
        <div class="cat-info"><div class="cat-name">${cat.name}</div><div class="cat-hint">${cat.hint}</div></div>
        <div class="cat-right"><div class="cat-total-amt zero" id="ct_${cat.id}">$0</div><div class="cat-total-lbl">deductible</div></div>
        <div class="chevron">▼</div></div>
      <div class="cat-body">${rows}</div>`;
    wrap.appendChild(card);
  });
  buildSummary(); updateMissing();
}

function toggle(id){document.getElementById('card_'+id).classList.toggle('open');}
function sv(id,v){vals[id]=parseFloat(v)||0;}
function setSld(id,v){sliders[id]=parseInt(v);document.getElementById('pct_'+id).textContent=v+'%';document.getElementById('sldD_'+id).textContent=v+'%';}
function hoPct(){const s=vals['ho_sqft']||0,t=vals['ho_home']||1;return t>0?Math.min(s/t,0.30):0;}
function lineDed(l){
  const v=vals[l.id]||0;
  if(l.type==='sqft'||l.type==='sqft_total') return 0;
  if(l.type==='miles') return v*MILEAGE;
  if(l.pct==='ho') return v*hoPct();
  if(l.type==='dollar_slider') return v*((sliders[l.id]||60)/100);
  if(typeof l.pct==='number') return v*(l.pct/100);
  return v;
}

function recalc(){
  let grand=0,filled=0;
  CATEGORIES.forEach(cat=>{
    let ct=0;
    cat.lines.forEach(l=>{
      const d=lineDed(l);ct+=d;
      if(vals[l.id]>0) filled++;
      const el=document.getElementById('ded_'+l.id);
      if(!el||l.type==='sqft'||l.type==='sqft_total') return;
      el.textContent='$'+Math.round(d).toLocaleString();
      el.className='ded-deductible'+(d>0?'':' zero');
    });
    grand+=ct;
    const ce=document.getElementById('ct_'+cat.id);
    if(ce){ce.textContent='$'+Math.round(ct).toLocaleString();ce.className='cat-total-amt'+(ct>0?'':' zero');}
  });
  document.getElementById('grandTotal').textContent='$'+Math.round(grand).toLocaleString();
  document.getElementById('sidebarTotal').textContent='$'+Math.round(grand).toLocaleString();
  const rate=parseFloat(document.getElementById('taxRate').value)||0.24;
  const saved=Math.round(grand*rate);
  document.getElementById('taxSave').textContent='≈ $'+saved.toLocaleString()+' in tax savings';
  document.getElementById('taxSave').className='tax-save'+(grand>0?' show':'');
  document.getElementById('sidebarSave').textContent='$'+saved.toLocaleString();
  document.getElementById('foundCount').textContent=filled;
  document.getElementById('foundBadge').className='found-badge'+(filled>0?' show':'');
  buildSummary();
  // Live readiness score in hero
  updateHeroReadiness(grand, filled);
}

function updateReadinessTip(grand, filled) {
  const tip = document.getElementById('rtItems');
  const footer = document.getElementById('rtFooter');
  if (!tip) return;

  const checks = [
    { label: 'Home office sq. footage entered',       done: (vals['ho_sqft']||0) > 0,               pts: '+5 pts' },
    { label: 'Business miles logged',                  done: (vals['v_miles']||0) > 0,               pts: '+5 pts' },
    { label: 'Health insurance premiums entered',      done: (vals['h_health']||0) > 0,              pts: '+5 pts' },
    { label: 'Retirement contribution entered',        done: ((vals['r_sep']||0)+(vals['r_401e']||0)) > 0, pts: '+5 pts' },
    { label: 'Software / tech expenses entered',       done: (vals['t_soft']||0) > 0,                pts: 'category' },
    { label: 'Marketing spend entered',                done: ((vals['mk_ads']||0)+(vals['mk_tools']||0)) > 0, pts: 'category' },
    { label: 'Professional services entered',          done: ((vals['p_legal']||0)+(vals['p_acct']||0)) > 0, pts: 'category' },
    { label: 'Total deductions over $5,000',           done: grand >= 5000,                          pts: '+5 pts' },
    { label: 'Total deductions over $15,000',          done: grand >= 15000,                         pts: '+5 pts' },
  ];

  const incomplete = checks.filter(c => !c.done);
  const complete   = checks.filter(c =>  c.done);

  let html = '';
  // Show incomplete first (what's left to do)
  incomplete.slice(0, 5).forEach(c => {
    html += `<div class="rt-item">
      <div class="rt-dot todo"></div>
      <div class="rt-text">${c.label} <span style="color:var(--gold);font-size:10.5px;font-weight:600;">${c.pts}</span></div>
    </div>`;
  });
  // Show completed items below
  complete.slice(0, 3).forEach(c => {
    html += `<div class="rt-item">
      <div class="rt-dot done"></div>
      <div class="rt-text done">${c.label}</div>
    </div>`;
  });

  tip.innerHTML = html;

  const remaining = incomplete.length;
  if (remaining === 0) {
    footer.textContent = '✓ All key items complete — Schedule C ready.';
    footer.style.color = 'var(--green)';
  } else {
    footer.textContent = `${remaining} item${remaining > 1 ? 's' : ''} left to maximize your score.`;
    footer.style.color = '';
  }
}

function updateHeroReadiness(grand, filled) {
  updateReadinessTip(grand, filled);
  const zeroCats = CATEGORIES.filter(c=>c.lines.reduce((s,l)=>s+lineDed(l),0)===0).map(c=>c.name);
  const score = calcReadinessScore(grand, zeroCats, vals);
  const fill = document.getElementById('heroRFill');
  const num = document.getElementById('heroScoreNum');
  const grade = document.getElementById('heroScoreGrade');
  if (!fill) return;
  const circumference = 200;
  fill.style.strokeDashoffset = circumference - (score/100)*circumference;
  num.textContent = score;
  if (score >= 80) {
    fill.style.stroke='#1A9E6E';
    grade.textContent='Schedule C\nReady';
    grade.innerHTML='Schedule C<br>Ready';
    grade.style.color='#1A9E6E';
  } else if (score >= 60) {
    fill.style.stroke='#C8973A';
    grade.innerHTML='Mostly<br>Ready';
    grade.style.color='#C8973A';
  } else if (score >= 40) {
    fill.style.stroke='#D97706';
    grade.innerHTML='Needs<br>Attention';
    grade.style.color='#D97706';
  } else if (score > 0) {
    fill.style.stroke='#C84040';
    grade.innerHTML='Not Ready<br>Yet';
    grade.style.color='#C84040';
  } else {
    fill.style.stroke='rgba(255,255,255,0.08)';
    grade.innerHTML='Start filling<br>to score';
    grade.style.color='';
  }
}

function buildSummary(){
  document.getElementById('summaryRows').innerHTML=CATEGORIES.map(cat=>{
    const t=cat.lines.reduce((s,l)=>s+lineDed(l),0);
    return`<div class="summary-row"><span class="s-cat">${cat.icon} ${cat.name}</span><span class="s-amt${t>0?'':' zero'}">$${Math.round(t).toLocaleString()}</span></div>`;
  }).join('');
}

function updateMissing(){
  const ind=document.getElementById('industry').value;
  const items=MISSING[ind]||MISSING.other;
  document.getElementById('missingItems').innerHTML=items.map(i=>`<div class="missing-item">${i}</div>`).join('');
}

// ─── READINESS SCORE (REFINEMENT 5) ───
function calcReadinessScore(grand, zeroCats, vals) {
  let score = 40; // base
  // Documentation completeness
  const totalCats = CATEGORIES.length;
  const filledCats = totalCats - zeroCats.length;
  score += Math.round((filledCats / totalCats) * 30);
  // Key items
  if (vals['ho_sqft'] > 0) score += 5;
  if (vals['v_miles'] > 0) score += 5;
  if ((vals['h_health']||0) > 0) score += 5;
  if ((vals['r_sep']||0)+(vals['r_401e']||0) > 0) score += 5;
  if (grand > 5000) score += 5;
  if (grand > 15000) score += 5;
  return Math.min(score, 100);
}

function renderReadiness(score) {
  const block = document.getElementById('readinessBlock');
  block.classList.add('show');
  const fill = document.getElementById('rFill');
  const num = document.getElementById('readinessNum');
  const grade = document.getElementById('readinessGrade');
  const sub = document.getElementById('readinessSub');
  const circumference = 220;
  const offset = circumference - (score/100)*circumference;
  setTimeout(() => {
    fill.style.strokeDashoffset = offset;
    num.textContent = score;
    if (score >= 80) {
      fill.style.stroke='#1A9E6E'; grade.textContent='Schedule C Ready';
      sub.textContent='Your documentation is solid. High confidence for filing or CPA handoff.';
    } else if (score >= 60) {
      fill.style.stroke='#C8973A'; grade.textContent='Mostly Ready — Close Gaps';
      sub.textContent='Good foundation. Addressing missing categories will strengthen your position significantly.';
    } else if (score >= 40) {
      fill.style.stroke='#D97706'; grade.textContent='Partial — Needs Attention';
      sub.textContent='Several key categories are empty. Filing with this profile leaves recoverable money unclaimed.';
    } else {
      fill.style.stroke='#C84040'; grade.textContent='Not Ready — High Risk';
      sub.textContent='Significant documentation gaps. Tax exposure is elevated. A Tax Rescue Session is strongly recommended.';
    }
  }, 100);
}

// ─── LLC RISK FLAG (REFINEMENT 4) ───
function renderLLCFlag(veilRisks) {
  const flag = document.getElementById('llcFlag');
  const body = document.getElementById('llcFlagBody');
  const items = document.getElementById('llcItems');
  const entity = document.getElementById('entityType').value;

  if (veilRisks && veilRisks.length > 0) {
    flag.classList.add('show');
    const isLLC = entity === 'llc' || entity === 's_corp' || entity === 'partnership';
    body.innerHTML = isLLC
      ? `<strong>${veilRisks.length} personal expense${veilRisks.length>1?'s':''} detected</strong> running through your business account. For LLCs and corporations, co-mingling personal and business expenses is one of the primary ways courts pierce the corporate veil — exposing your personal assets to business liability.`
      : `<strong>${veilRisks.length} personal expense${veilRisks.length>1?'s':''} detected</strong> on your business account. While less critical for sole proprietors, separating these now builds cleaner records for any future entity upgrade.`;
    items.innerHTML = veilRisks.map(r =>
      `<div class="llc-item"><strong>${r.desc}</strong> — $${r.amt.toFixed(2)} (personal charge on business account)</div>`
    ).join('');
  } else {
    flag.classList.add('show');
    flag.style.background='var(--green-bg)';
    flag.style.borderColor='rgba(26,158,110,0.3)';
    document.querySelector('.llc-flag-title').style.color='var(--green)';
    document.querySelector('.llc-flag-badge').style.background='var(--green)';
    document.querySelector('.llc-flag-badge').textContent='CLEAR';
    body.innerHTML='<strong style="color:var(--green)">No corporate veil threats detected.</strong> All visible transactions appear to be properly business-related. Maintain this separation to protect your entity liability shield.';
    items.innerHTML='';
  }
}

// ─── MAIN AI ANALYSIS ───
async function runAnalysis() {
  const btn=document.getElementById('aiBtn');
  btn.disabled=true;btn.textContent='⏳ Analyzing...';
  const panel=document.getElementById('aiPanel');
  panel.classList.add('show');
  panel.scrollIntoView({behavior:'smooth',block:'start'});
  document.getElementById('aiSpinner').classList.add('show');
  document.getElementById('aiText').classList.remove('show');
  document.getElementById('actionStrip').style.display='none';

  const grand=CATEGORIES.reduce((s,c)=>s+c.lines.reduce((ss,l)=>ss+lineDed(l),0),0);
  const rate=parseFloat(document.getElementById('taxRate').value)||0.24;
  const saved=Math.round(grand*rate);
  const entity=document.getElementById('entityType').options[document.getElementById('entityType').selectedIndex].text;
  const industry=document.getElementById('industry').options[document.getElementById('industry').selectedIndex].text;
  const zeroCats=CATEGORIES.filter(c=>c.lines.reduce((s,l)=>s+lineDed(l),0)===0).map(c=>c.name);
  const topCats=CATEGORIES.map(c=>({name:c.name,t:Math.round(c.lines.reduce((s,l)=>s+lineDed(l),0))})).filter(c=>c.t>0).sort((a,b)=>b.t-a.t).slice(0,4);
  const veilRisks=window._veilRisks||[];

  // REFINEMENT 5: Render readiness score
  const readiness=calcReadinessScore(grand, zeroCats, vals);
  renderReadiness(readiness);

  // REFINEMENT 4: Render LLC flag
  renderLLCFlag(veilRisks);

  const profile=`Entity: ${entity}. Industry: ${industry}. Bracket: ${Math.round(rate*100)}%. Total deductions: $${Math.round(grand).toLocaleString()}. Est. tax savings: $${saved.toLocaleString()}. Schedule C Readiness: ${readiness}/100. Top categories: ${topCats.map(c=>c.name+' ($'+c.t.toLocaleString()+')').join(', ')}. Zero categories: ${zeroCats.join(', ')||'none'}. Veil risks detected: ${veilRisks.length}. Retirement: $${Math.round((vals['r_sep']||0)+(vals['r_401e']||0)+(vals['r_401r']||0)).toLocaleString()}. Health insurance: $${Math.round(vals['h_health']||0).toLocaleString()}.`;

  try {
    const res=await fetch("https://api.anthropic.com/v1/messages",{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        model:"claude-sonnet-4-20250514",max_tokens:1000,
        system:"You are Sarah Mae Gordon, founder of FiscalAI. Strategic Finance Architect — 10+ years at Mastercard and Ameriprise Financial. Genius Mode: dense, precise, warmly authoritative. No disclaimers. Direct advisor voice.",
        messages:[{role:"user",content:`Business owner used the FiscalAI Deduction Decoder. Profile:\n${profile}\n\nWrite 4 punchy paragraphs — no headers, no bullets:\n\nPara 1: What their $${Math.round(grand).toLocaleString()} total and ${readiness}/100 readiness score signals. Translate $${saved.toLocaleString()} saved into something real and tangible.\n\nPara 2: Pick their 2 most glaring zero categories. Name the specific deduction they almost certainly have but didn't enter. Be dollar-specific.\n\nPara 3: Their single highest-ROI move for their entity type and bracket. Concrete — with a number.\n\nPara 4: What April 15 means for them right now. Real consequence of inaction. One sentence pulling toward the Tax Rescue Session.\n\nUnder 300 words. Sharp, direct, no filler.`}]
      })
    });
    const data=await res.json();
    const text=data.content?.[0]?.text||fallback(grand,saved,zeroCats,entity,readiness);
    document.getElementById('aiSpinner').classList.remove('show');
    const t=document.getElementById('aiText');t.textContent=text;t.classList.add('show');
    document.getElementById('actionStrip').style.display='flex';
  } catch(e) {
    document.getElementById('aiSpinner').classList.remove('show');
    const t=document.getElementById('aiText');t.textContent=fallback(grand,saved,zeroCats,entity,readiness);t.classList.add('show');
    document.getElementById('actionStrip').style.display='flex';
  }
  btn.textContent='✓ Analysis Complete';
}

function fallback(grand,saved,zeroCats,entity,readiness) {
  const top2=zeroCats.slice(0,2).join(' and ');
  return`You've identified $${Math.round(grand).toLocaleString()} in recoverable deductions with a ${readiness}/100 Schedule C Readiness Score — that's $${saved.toLocaleString()} that stays in your business instead of going to the IRS. Reinvested, that's a product launch, a quarter of a hire, or three months of operating runway.\n\nYour report shows $0 in ${top2||'several key categories'} — and that's almost never accurate for an active business. Health insurance premiums at $400/month represent $4,800 in above-the-line deductions most operators miss entirely. That reduces your adjusted gross income at the federal, state, and self-employment level simultaneously.\n\nFor a ${entity}, the single highest-leverage move before April 15 is establishing and funding a SEP-IRA. You can contribute up to 25% of net self-employment income — deadline is your filing date including extensions. At 24%, a $10,000 SEP contribution generates $2,400 in immediate federal savings plus SE tax reduction.\n\nEvery day past April 15 without a filed return or extension accumulates 5% of unpaid tax per month. The $${saved.toLocaleString()} this report shows is the floor. The Tax Rescue Session turns this decoder output into a complete, CPA-ready filing position — same day.`;
}

function resetAll(){
  document.getElementById('categories').innerHTML='';
  Object.keys(vals).forEach(k=>vals[k]=0);
  Object.keys(sliders).forEach(k=>delete sliders[k]);
  buildUI();recalc();
  document.getElementById('aiPanel').classList.remove('show');
  document.getElementById('readinessBlock').classList.remove('show');
  document.getElementById('llcFlag').classList.remove('show');
  document.getElementById('aiBtn').disabled=false;
  document.getElementById('aiBtn').textContent='🔍 Run Full GL Analysis';
  document.getElementById('parsedResults').classList.remove('show');
  document.getElementById('parseBar').classList.remove('show');
  uploadUsed=false; pendingFile=null;
  window.scrollTo({top:0,behavior:'smooth'});
}

buildUI();recalc();
</script>
