async function classifyWithAI(transactions) {
  const txnList = transactions.map((t,i) => `${i+1}. ${t.date} | ${t.desc} | $${t.amt.toFixed(2)}`).join('\n');
  try {
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method:"POST", headers:{"Content-Type":"application/json"},
      body: JSON.stringify({
        model:"claude-sonnet-4-20250514", max_tokens:1200,
        system:"You are a tax GL classification engine. Respond ONLY with valid JSON — no markdown, no explanation, no backticks.",
        messages:[{role:"user", content:`Classify each transaction as a business deduction category. Return ONLY a JSON array.

Transactions:
${txnList}

For each return: {"i":<1-based index>,"cat":"<category>","conf":"<high|mid|low>","deductible":<true|false>,"veil_risk":<true|false>}

Categories: tech, marketing, travel, hotel, meals, health, office, professional, education, phone, banking, other, personal
- deductible:false for personal expenses (groceries, Netflix personal, gym, personal clothing, etc.)
- veil_risk:true if a PERSONAL expense appears to have been run through a business account (threatens LLC corporate veil)
Return ONLY the JSON array.`}]
      })
    });
    const data = await res.json();
    let text = data.content?.[0]?.text || '[]';
    text = text.replace(/```json|```/g,'').trim();
    let classified = [];
    try { classified = JSON.parse(text); } catch(e) { classified = []; }
    renderTransactions(transactions, classified);
  } catch(e) {
    const fallback = transactions.map((t,i) => ({
      i: i+1, cat: guessCategory(t.desc),
      conf: 'mid', deductible: !isPersonal(t.desc), veil_risk: isPersonal(t.desc)
    }));
    renderTransactions(transactions, fallback);
  }
}

function isPersonal(desc) {
  return /NETFLIX|HULU|SPOTIFY|GROCERY|WHOLE FOODS|TARGET|WALMART|GYM|FITNESS|PERSONAL|CLOTHING|RESTAURANT PERSONAL/i.test(desc);
}

function guessCategory(desc) {
  desc = desc.toUpperCase();
  if (isPersonal(desc)) return 'personal';
  if (/ADOBE|ZOOM|GOOGLE|QUICKBOOKS|APOLLO|CANVA|AWS|LINKEDIN|MICROSOFT|SLACK/.test(desc)) return 'tech';
  if (/DELTA|UNITED|AMERICAN AIR|SOUTHWEST|LYFT|UBER(?!.*EATS)/.test(desc)) return 'travel';
  if (/MARRIOTT|HILTON|HYATT|AIRBNB|HOTEL/.test(desc)) return 'hotel';
  if (/EATS|GRUBHUB|DINNER|LUNCH|STARBUCKS/.test(desc)) return 'meals';
  if (/INSURANCE|BLUE CROSS|AETNA|CIGNA/.test(desc)) return 'health';
  if (/STAPLES|OFFICE DEPOT/.test(desc)) return 'office';
  if (/LEGAL|NOTARY|ATTORNEY|FILING/.test(desc)) return 'professional';
  if (/COURSERA|UDEMY|COURSE|BOOK/.test(desc)) return 'education';
  if (/AT&T|VERIZON|T-MOBILE|WIRELESS/.test(desc)) return 'phone';
  return 'other';
}

